# ===== Local Development =====

# SQLite database file (relative to project root)
DATABASE_URL="file:./prisma/dev.db"

# Public site URL (used for callback URL in dev)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin password for /admin login
ADMIN_PASSWORD="admin123456"

# Session secret used to sign cookie session
SESSION_SECRET="please-change-me-in-production"

# ===== Default API: Kie.ai GPT Image-2 =====
KIE_API_KEY=""

# ===== AI agent for parsing API docs =====
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: override OpenAI base URL for proxy / compatible providers
# OPENAI_BASE_URL="https://api.openai.com/v1"
