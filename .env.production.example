# ===== Production (VPS / Docker) =====

# SQLite path inside the container; mapped to a host volume
DATABASE_URL="file:/app/data/prod.db"

# Your public domain (used to build callback URLs)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Strong password for /admin login
ADMIN_PASSWORD="please-change-me-to-a-strong-password"

# Random long string used to sign cookie session
SESSION_SECRET="please-change-me-to-a-long-random-string"

# ===== Default API: Kie.ai GPT Image-2 =====
KIE_API_KEY="your_kie_api_key"

# ===== AI agent for parsing API docs =====
AI_PROVIDER="openai"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
